{
  "name": "web-adventure",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "pnpm run lint:eslint && pnpm run lint:oxfmt && pnpm run lint:knip",
    "lint:eslint": "eslint --cache --max-warnings 0",
    "lint:oxfmt": "oxfmt --check",
    "lint:knip": "knip",
    "fix": "pnpm run fix:oxfmt && pnpm run fix:eslint",
    "fix:oxfmt": "oxfmt",
    "fix:eslint": "eslint --cache --max-warnings 0 --fix",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:install": "playwright install chromium",
    "typecheck": "astro check",
    "postinstall": "simple-git-hooks"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "astro": "^7.4.4",
    "canvas-confetti": "^1.9.4",
    "preact": "^10.29.8",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.5",
    "@axe-core/playwright": "^4.14.0",
    "@ocavue/eslint-config": "^4.20.2",
    "@ocavue/tsconfig": "^0.7.1",
    "@playwright/test": "^1.64.0",
    "@stylexjs/eslint-plugin": "^0.19.1",
    "@stylexjs/stylex": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@testing-library/preact": "^3.2.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.0.0",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "knip": "^6.36.0",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.71.0",
    "shiki": "^4.5.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "nano-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged --allow-empty -u"
  }
}
