---
import '../styles/global.css'

import * as stylex from '@stylexjs/stylex'

import { AppShell } from '../islands/shell/AppShell.tsx'
import { STORE_KEY } from '../lib/store.ts'
import { THEME_CLASSES, THEME_COLORS } from '../lib/theme.ts'
import type { ModuleId } from '../lib/types.ts'
import { moduleThemes } from '../styles/themes.ts'

import { styles } from './base.styles.ts'

interface Props {
  /** The page title, without the site name. */
  title: string
  description: string
  /** The accent color of a trail page. */
  mod?: ModuleId
  /** Pages that only make sense with local progress are not indexed. */
  noindex?: boolean
  /** Structured data for search engines. */
  jsonLd?: Record<string, unknown>
  /** Renders the app shell: top bar, settings, onboarding, and toasts. The lesson page turns it off. */
  topbar?: boolean
  /** Offers the welcome dialog to a new player. Only the home and trail pages turn it on. */
  onboarding?: boolean
}

const {
  title,
  description,
  mod,
  noindex = false,
  jsonLd,
  topbar = true,
  onboarding = false,
} = Astro.props
const fullTitle = title === 'Byte Trail' ? title : `${title} · Byte Trail`
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL('/og.png', Astro.site)

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={THEME_COLORS.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={THEME_COLORS.dark} media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Byte Trail" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Byte Trail: learn web dev one small step at a time" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Inline, because the opt-in must be known before the new page renders. In the external
    stylesheet it arrived too late, and Chromium aborted the navigation transition. */}
    <style is:inline>
      @view-transition {
        navigation: auto;
      }
    </style>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline define:vars={{ key: STORE_KEY, classes: THEME_CLASSES, colors: THEME_COLORS }}>
      // Runs before the first paint, so the page does not flash: applies the saved theme, and marks a
      // returning player, whose progress-dependent content stays hidden until its island is ready.
      try {
        const saved = JSON.parse(localStorage.getItem(key) ?? '{}') ?? {}
        const settings = saved.settings ?? {}
        const root = document.documentElement
        if (settings.theme === 'light' || settings.theme === 'dark') {
          root.classList.add(...classes[settings.theme].split(' '))
          root.dataset.theme = settings.theme
          for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
            meta.content = colors[settings.theme]
          }
        }
        if (settings.calm) root.dataset.calm = ''
        if (saved.onboarded || saved.xp > 0) root.dataset.returning = ''
      } catch {}
    </script>
    {
      import.meta.env.DEV && (
        // In dev, StyleX serves its CSS from a virtual module. The runtime refetches it on HMR.
        <>
          <link rel="stylesheet" href="/virtual:stylex.css" />
          <script is:inline type="module" src="/@id/virtual:stylex:runtime" />
        </>
      )
    }
  </head>
  <body {...stylex.attrs(styles.body, mod && moduleThemes[mod])}>
    <div {...stylex.attrs(styles.contours)} aria-hidden="true"></div>
    <div {...stylex.attrs(styles.safeArea)} aria-hidden="true"></div>
    {topbar && <AppShell onboarding={onboarding} client:load />}
    <slot />
  </body>
</html>
