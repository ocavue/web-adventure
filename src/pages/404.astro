---
import * as stylex from '@stylexjs/stylex'

import { Buddy } from '../components/ui/Bit.tsx'
import { Button } from '../components/ui/Button.tsx'
import Base from '../layouts/Base.astro'
import { layout, text } from '../styles/shared.ts'

import { styles } from './_404.styles.ts'
---

<Base title="Page not found" description="This page does not exist on Web Adventure." noindex>
  <main {...stylex.attrs(layout.wrap, styles.main)}>
    <h1 {...stylex.attrs(text.display, text.h1, styles.title)}>Page not found</h1>
    <Buddy mood="wow" size="large" xstyle={styles.buddy}>
      Whoa, the trail ends here! This page does not exist, but plenty of lessons do.
    </Buddy>
    <Button href="/" variant="primary" icon="map">Back to the trailhead</Button>
  </main>
</Base>
