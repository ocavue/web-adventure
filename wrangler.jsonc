{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-adventure",
  "compatibility_date": "2026-10-01",
  // `wrangler deploy` runs this first, so Cloudflare Workers Builds needs no build command of its own.
  "build": {
    "command": "pnpm run build",
  },
  "assets": {
    "directory": "./dist",
  },
}
